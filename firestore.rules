rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ¿Este dispositivo ya ingresó el código del grupo?
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    // Gastos y datos del evento: todos los ven, solo el grupo los modifica.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isMember();
    }
    match /expenses/{docId} {
      allow read: if request.auth != null;
      allow write: if isMember();
    }

    // Un dispositivo se suma al grupo creando su propio documento en /members
    // con el código correcto. El código se compara contra /private/joinCode,
    // que nadie puede leer desde la app (las reglas sí pueden consultarlo).
    match /members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'joinedAt'])
        && request.resource.data.code
           == get(/databases/$(database)/documents/private/joinCode).data.value;
      allow update, delete: if false;
    }

    // El código del grupo vive acá. Se carga a mano en Firebase Console.
    match /private/{docId} {
      allow read, write: if false;
    }
  }
}
