rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ¿Este dispositivo ya ingresó el código del grupo?
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    // Datos del evento: todos los ven, solo el grupo los modifica.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isMember();

      // El código del grupo vive en config/main/private/joincode.
      // Nadie lo puede leer ni cambiar desde la app (las reglas sí pueden consultarlo).
      match /private/{secretId} {
        allow read, write: if false;
      }
    }

    // Gastos: todos los ven, solo el grupo los modifica.
    match /expenses/{docId} {
      allow read: if request.auth != null;
      allow write: if isMember();
    }

    // Un dispositivo se suma al grupo creando su propio documento en /members
    // con el código correcto (mínimo 6 caracteres, nunca vacío).
    match /members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'joinedAt'])
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 6
        && request.resource.data.code
           == get(/databases/$(database)/documents/config/main/private/joincode).data.value;
      allow update, delete: if false;
    }
  }
}
